{
  // Lamplight connection relay. Deploy with `npx wrangler deploy` from this folder, or connect the
  // repo in Cloudflare (Workers & Pages → Create → Import a repository, root directory `relay`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lamplight-relay",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  // relay.lamplight.cards is attached in the dashboard (Settings → Domains & Routes → Custom
  // domain) rather than here, so deploying doesn't need permission to change DNS
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      // anonymous error reports from the app (see Reports in src/index.ts)
      { "name": "REPORTS", "class_name": "Reports" },
    ],
  },
  // SQLite-backed Durable Objects are available on the Workers free plan
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Reports"] },
  ],
  // new connections per address a minute: slows anyone trying table codes to find live tables
  // (Workers rate limiting; the namespace id is any number unique to this account)
  "ratelimits": [{ "name": "CONNECTS", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  "vars": {
    // sites allowed to connect (besides localhost); "*." allows any subdomain, e.g. Pages previews
    "ALLOWED_ORIGINS": "https://lamplight.cards,https://*.lamplight.cards,https://*.pages.dev",
  },
  "observability": { "enabled": true },
}

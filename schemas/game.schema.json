{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jackhale98/cards/schemas/game.schema.json",
  "title": "Card game definition",
  "description": "Declarative setup for a game in src/games/<id>/game.json. Add a rules.ts beside it to enforce rules; without one the game runs on the Free Table engine.",
  "type": "object",
  "required": [
    "id",
    "name",
    "tagline",
    "icon",
    "players",
    "deck",
    "zones",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Must match the folder name."
    },
    "name": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "maxLength": 4
    },
    "players": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "recommended": {
          "type": "integer"
        }
      }
    },
    "bots": {
      "type": "boolean",
      "description": "Seats may be filled by bots (rules.ts must implement bot())."
    },
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "jokers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "ranks": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 2,
            "maximum": 14
          },
          "description": "Ace is 14."
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Card ids to leave out, e.g. [\"4S\", \"4C\"]."
        }
      }
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "properties": {
          "id": {
            "const": "deck"
          }
        }
      },
      "items": {
        "type": "object",
        "required": [
          "id",
          "visibility",
          "layout",
          "area"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]*$"
          },
          "label": {
            "type": "string"
          },
          "perPlayer": {
            "type": "boolean"
          },
          "visibility": {
            "enum": [
              "all",
              "owner",
              "none"
            ],
            "description": "Who may see the cards."
          },
          "layout": {
            "enum": [
              "fan",
              "stack",
              "spread",
              "trick"
            ]
          },
          "area": {
            "enum": [
              "hand",
              "center",
              "strip",
              "seat",
              "none"
            ],
            "description": "Where the zone is drawn: the hand, the centre, a compact sideways-scrolling strip along the bottom of the table, by a seat, or nowhere."
          },
          "hideEmpty": {
            "type": "boolean",
            "description": "Don't draw the zone while it's empty."
          },
          "scale": {
            "type": "number",
            "minimum": 0.3,
            "maximum": 1.5,
            "description": "Card size relative to other table cards (e.g. 0.6 for many small melds)."
          }
        }
      }
    },
    "deal": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "to",
          "count"
        ],
        "additionalProperties": false,
        "properties": {
          "to": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "faceUp": {
            "type": "boolean"
          }
        }
      }
    },
    "chips": {
      "type": "object",
      "required": [
        "start"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "smallBlind": {
          "type": "integer"
        },
        "bigBlind": {
          "type": "integer"
        }
      }
    },
    "sort": {
      "type": "object",
      "properties": {
        "aceLow": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "undo": {
      "type": "boolean"
    },
    "rulesSummary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "type",
          "default"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "enum": [
              "number",
              "boolean"
            ]
          },
          "default": {
            "type": [
              "number",
              "boolean"
            ]
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "step": {
            "type": "number"
          }
        }
      }
    },
    "rules": {
      "description": "Which family engine runs the game, and its parameters.",
      "type": "object",
      "required": [
        "family"
      ],
      "oneOf": [
        {
          "properties": {
            "family": {
              "const": "free"
            }
          },
          "additionalProperties": false,
          "description": "No rules enforced: players move cards freely."
        },
        {
          "description": "Trick-taking games: Hearts, Spades, Oh Hell, Whist…",
          "required": [
            "family",
            "scoring",
            "end"
          ],
          "additionalProperties": false,
          "properties": {
            "family": {
              "const": "trick-taking"
            },
            "handSizes": {
              "oneOf": [
                {
                  "enum": [
                    "all",
                    "ladder"
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              ],
              "description": "\"all\" deals the whole deck; \"ladder\" goes 1 → maxHand → 1; or an explicit list per round."
            },
            "maxHand": {
              "type": "integer",
              "minimum": 1
            },
            "passing": {
              "type": "object",
              "required": [
                "count",
                "cycle"
              ],
              "additionalProperties": false,
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 1
                },
                "cycle": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "left",
                      "right",
                      "across",
                      "hold"
                    ]
                  }
                }
              }
            },
            "lead": {
              "enum": [
                "twoOfClubs",
                "leftOfDealer",
                "maker"
              ]
            },
            "trump": {
              "enum": [
                "none",
                "S",
                "H",
                "D",
                "C",
                "turnUp",
                "chosen"
              ],
              "description": "\"chosen\" = decided by the bidding (euchre, 500)."
            },
            "breaks": {
              "enum": [
                "S",
                "H",
                "D",
                "C"
              ],
              "description": "Suit that can't be led until one has been played."
            },
            "noPointsFirstTrick": {
              "type": "boolean"
            },
            "teams": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "bidding": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "tricks"
                    },
                    "nil": {
                      "type": "boolean"
                    },
                    "hook": {
                      "type": "boolean",
                      "description": "Dealer can't make total bids equal the tricks available."
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "euchre"
                    },
                    "stickTheDealer": {
                      "type": "boolean"
                    },
                    "alone": {
                      "type": "boolean"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "schedule"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "auction"
                    },
                    "schedule": {
                      "const": "avondale"
                    },
                    "misere": {
                      "type": "boolean",
                      "description": "Allow misère (250, over a seven) and open misère (500, any time below 10♥). Needs a `dummy` zone for the open hand."
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "bridge"
                    }
                  },
                  "description": "Contract bridge auction: bids 1–7 in ♣ ♦ ♥ ♠ NT, pass, double, redouble. The declarer's partner is dummy."
                }
              ]
            },
            "scoring": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "type",
                    "cardPoints"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "penalty"
                    },
                    "cardPoints": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "number"
                      },
                      "description": "Keys are a suit letter (every card of that suit) or a card id like \"QS\"."
                    },
                    "moon": {
                      "type": "boolean"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "contract"
                    },
                    "nil": {
                      "type": "number"
                    },
                    "bags": {
                      "type": "object",
                      "required": [
                        "every",
                        "penalty"
                      ],
                      "properties": {
                        "every": {
                          "type": "integer"
                        },
                        "penalty": {
                          "type": "number"
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "bonus"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "exact"
                    },
                    "bonus": {
                      "type": "number"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "tricks"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "euchre"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "perTrick"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "auction"
                    },
                    "perTrick": {
                      "type": "number"
                    },
                    "slam": {
                      "type": "number"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "bridge"
                    }
                  },
                  "description": "Duplicate bridge scoring per deal, Chicago vulnerability."
                }
              ]
            },
            "end": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "target": {
                  "type": "number"
                },
                "lowWins": {
                  "type": "boolean"
                },
                "rounds": {
                  "type": "boolean"
                },
                "deals": {
                  "type": "number",
                  "description": "Play this many deals (option `deals` overrides)."
                },
                "loseAt": {
                  "type": "number",
                  "description": "A side at or below this score loses (500: -500)."
                }
              }
            },
            "bowers": {
              "type": "boolean",
              "description": "Jack of trumps and the same-colour jack are the top two trumps."
            },
            "joker": {
              "type": "boolean",
              "description": "A joker is the highest trump (500)."
            },
            "kitty": {
              "type": "integer",
              "minimum": 0,
              "description": "Cards left undealt for the bid winner (500)."
            }
          }
        },
        {
          "description": "Community-card poker: Hold'em, Omaha…",
          "required": [
            "family",
            "holeCards",
            "board"
          ],
          "additionalProperties": false,
          "properties": {
            "family": {
              "const": "poker"
            },
            "holeCards": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            },
            "useHole": {
              "type": "integer",
              "minimum": 0,
              "description": "0 = any five cards; N = exactly N hole cards."
            },
            "board": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "description": "Community cards dealt on each street."
            }
          }
        },
        {
          "description": "Rummy games. Style \"gin\": two players draw and discard until someone knocks.",
          "required": [
            "family",
            "style",
            "handSize",
            "knockMax",
            "bonuses",
            "end"
          ],
          "additionalProperties": false,
          "properties": {
            "family": {
              "const": "rummy"
            },
            "style": {
              "enum": [
                "gin"
              ]
            },
            "handSize": {
              "type": "integer",
              "minimum": 3,
              "maximum": 13
            },
            "knockMax": {
              "type": "integer",
              "minimum": 0,
              "description": "Most deadwood you may knock with; 0 = gin only."
            },
            "bonuses": {
              "type": "object",
              "required": [
                "gin",
                "undercut"
              ],
              "additionalProperties": false,
              "properties": {
                "gin": {
                  "type": "number"
                },
                "bigGin": {
                  "type": "number"
                },
                "undercut": {
                  "type": "number"
                },
                "box": {
                  "type": "number"
                },
                "game": {
                  "type": "number"
                }
              }
            },
            "end": {
              "type": "object",
              "required": [
                "target"
              ],
              "additionalProperties": false,
              "properties": {
                "target": {
                  "type": "number"
                }
              }
            }
          }
        },
        {
          "description": "Rummy 500: 2–6 players meld and lay off on the table; melded cards score, cards in hand count against you.",
          "required": [
            "family",
            "style",
            "end"
          ],
          "additionalProperties": false,
          "properties": {
            "family": {
              "const": "rummy"
            },
            "style": {
              "const": "500"
            },
            "end": {
              "type": "object",
              "required": [
                "target"
              ],
              "additionalProperties": false,
              "properties": {
                "target": {
                  "type": "number"
                }
              }
            }
          }
        },
        {
          "description": "Cribbage for 2–4 players (4 = partnerships).",
          "required": [
            "family",
            "target"
          ],
          "additionalProperties": false,
          "properties": {
            "family": {
              "const": "cribbage"
            },
            "target": {
              "type": "integer",
              "minimum": 31,
              "description": "Points to win (121 standard, 61 for a short game)."
            }
          }
        }
      ]
    }
  }
}

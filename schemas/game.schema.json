{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jackhale98/cards/schemas/game.schema.json",
  "title": "Card game definition",
  "description": "Declarative setup for a game in src/games/<id>/game.json: its `rules` block picks a family engine and sets its parameters (a rules.ts beside it can replace the family for a true one-off).",
  "type": "object",
  "required": ["id", "name", "tagline", "icon", "players", "deck", "zones", "rules"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Must match the folder name."
    },
    "name": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Other names the game goes by, so the picker's search finds it (\"ERS\", \"Bullshit\")."
    },
    "icon": {
      "type": "string",
      "maxLength": 4
    },
    "players": {
      "title": "PlayerCounts",
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "recommended": {
          "type": "integer"
        },
        "counts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Only these numbers of players are allowed (when not every count from min to max works)."
        }
      }
    },
    "bots": {
      "type": "boolean",
      "description": "Seats may be filled by bots (the engine must implement bot())."
    },
    "deck": {
      "$ref": "#/$defs/DeckSpec"
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "properties": {
          "id": {
            "const": "deck"
          }
        }
      },
      "items": {
        "title": "ZoneConfig",
        "type": "object",
        "required": ["id", "visibility", "layout", "area"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]*$"
          },
          "label": {
            "type": "string"
          },
          "perPlayer": {
            "type": "boolean"
          },
          "visibility": {
            "enum": ["all", "owner", "none"],
            "description": "Who may see the cards."
          },
          "layout": {
            "enum": ["fan", "stack", "spread", "trick"]
          },
          "area": {
            "enum": ["hand", "center", "strip", "seat", "none"],
            "description": "Where the zone is drawn: the hand, the centre, a compact sideways-scrolling strip along the bottom of the table, by a seat, or nowhere."
          },
          "hideEmpty": {
            "type": "boolean",
            "description": "Don't draw the zone while it's empty."
          },
          "scale": {
            "type": "number",
            "minimum": 0.3,
            "maximum": 1.5,
            "description": "Card size relative to other table cards (e.g. 0.6 for many small melds)."
          },
          "peek": {
            "type": "integer",
            "minimum": 2,
            "maximum": 4,
            "description": "A stack that shows its top few face-up cards overlapping, not just the top one (slap games)."
          },
          "faceUpHand": {
            "type": "boolean",
            "description": "A whole hand laid face up on the table (bridge's dummy): drawn the same way however many cards are left, so the rest don't jump about as cards are played from it; and once down it keeps its room until the middle is clear, so the last trick doesn't jump into its place."
          },
          "piles": {
            "type": "boolean",
            "description": "Melds of one rank (canasta's): each drawn as one squared pile with a count, its first card on top, and any cards of another rank in it (wild cards) fanned beside it, instead of every card in a row."
          },
          "reserve": {
            "type": "integer",
            "minimum": 2,
            "maximum": 20,
            "description": "A pile spread out card by card that keeps growing (rummy 500's discard pile): on a table screen it keeps room for this many cards, overlapped the same from the first and more as it passes that, so the piles beside it don't slide about."
          },
          "cascade": {
            "type": "boolean",
            "description": "A stack laid out as a cascade (Kings Corners): its bottom card peeks out above the top one, and no count is shown."
          },
          "grid": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "Where the pile sits on the table, [row, column]: with every middle pile placed, a big screen lays them out so (a cross for Kings Corners), and a phone puts them in one row in reading order."
          }
        }
      }
    },
    "deal": {
      "type": "array",
      "items": {
        "title": "DealStep",
        "type": "object",
        "required": ["to", "count"],
        "additionalProperties": false,
        "properties": {
          "to": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "faceUp": {
            "type": "boolean"
          }
        }
      }
    },
    "chips": {
      "title": "ChipsConfig",
      "type": "object",
      "required": ["start"],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "smallBlind": {
          "type": "integer"
        },
        "bigBlind": {
          "type": "integer"
        },
        "ante": {
          "type": "integer"
        }
      }
    },
    "sort": {
      "type": "object",
      "properties": {
        "aceLow": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "undo": {
      "type": "boolean"
    },
    "rulesSummary": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "How to play, in the table menu: short lines on the goal, the deal, a turn, scoring and the end (docs/ADDING_A_GAME.md). Rules for one table size go in `byPlayers`."
    },
    "options": {
      "type": "array",
      "items": {
        "title": "GameOption",
        "type": "object",
        "required": ["id", "label", "type", "default"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "about": {
            "type": "string",
            "description": "A line under the option in the lobby: what it does, where How to play has no room for it (a practice mode, say)."
          },
          "type": {
            "enum": ["number", "boolean"]
          },
          "default": {
            "type": ["number", "boolean"]
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "step": {
            "type": "number"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Show a number option as named choices; the value is the index."
          }
        }
      }
    },
    "rules": {
      "description": "Which family engine runs the game, and its parameters.",
      "type": "object",
      "required": ["family"],
      "oneOf": [
        {
          "$ref": "#/$defs/FreeRules"
        },
        {
          "$ref": "#/$defs/TrickTakingRules"
        },
        {
          "$ref": "#/$defs/PokerRules"
        },
        {
          "$ref": "#/$defs/GinRules"
        },
        {
          "$ref": "#/$defs/Rummy500Rules"
        },
        {
          "$ref": "#/$defs/CribbageRules"
        },
        {
          "$ref": "#/$defs/ClimbingRules"
        },
        {
          "$ref": "#/$defs/CanastaRules"
        },
        {
          "$ref": "#/$defs/EightsRules"
        },
        {
          "$ref": "#/$defs/BaccaratRules"
        },
        {
          "$ref": "#/$defs/BlackjackRules"
        },
        {
          "$ref": "#/$defs/CheatRules"
        },
        {
          "$ref": "#/$defs/GoFishRules"
        },
        {
          "$ref": "#/$defs/PalaceRules"
        },
        {
          "$ref": "#/$defs/CornersRules"
        },
        {
          "$ref": "#/$defs/HandFootRules"
        },
        {
          "$ref": "#/$defs/SpoonsRules"
        },
        {
          "$ref": "#/$defs/SpitRules"
        },
        {
          "$ref": "#/$defs/SlapRules"
        },
        {
          "$ref": "#/$defs/PinochleRules"
        }
      ],
      "title": "Rules"
    },
    "byPlayers": {
      "type": "object",
      "description": "Changes for a particular number of players, keyed by the count (\"3\", \"5\"…): rule parameters merged over `rules`, deck settings over `deck`, and extra how-to-play lines.",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rules": {
              "type": "object",
              "additionalProperties": true,
              "description": "Settings merged over `rules` at this size (the merged rules are checked against the family by tests/schema.test.ts)."
            },
            "deck": {
              "$ref": "#/$defs/DeckSpec"
            },
            "rulesSummary": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "How-to-play lines shown after `rulesSummary` only when this many play (the deck, deal or partnerships at this size)."
            }
          },
          "title": "SizeOverrides"
        }
      },
      "additionalProperties": false
    },
    "category": {
      "type": "string",
      "description": "Picker section (Poker, Casino, Trick-taking, Rummy, Shedding, Family, Speed, More). Defaults to one based on the rules family."
    }
  },
  "$defs": {
    "FreeRules": {
      "title": "FreeRules",
      "properties": {
        "family": {
          "const": "free"
        }
      },
      "additionalProperties": false,
      "description": "No rules enforced: players move cards freely."
    },
    "TrickTakingRules": {
      "title": "TrickTakingRules",
      "description": "Trick-taking games: Hearts, Spades, Oh Hell, Whist…",
      "required": ["family", "scoring", "end"],
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "trick-taking"
        },
        "handSizes": {
          "oneOf": [
            {
              "enum": ["all", "ladder"]
            },
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          ],
          "description": "\"all\" deals the whole deck; \"ladder\" goes 1 → maxHand → 1; or an explicit list per round."
        },
        "maxHand": {
          "type": "integer",
          "minimum": 1
        },
        "passing": {
          "type": "object",
          "required": ["count", "cycle"],
          "additionalProperties": false,
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "cycle": {
              "type": "array",
              "items": {
                "enum": ["left", "right", "across", "hold", "left2", "right2"]
              }
            }
          }
        },
        "lead": {
          "enum": ["twoOfClubs", "leftOfDealer", "maker"]
        },
        "trump": {
          "enum": ["none", "S", "H", "D", "C", "turnUp", "chosen", "lastCard", "pitched"],
          "description": "\"chosen\" = decided by the bidding (euchre, 500); \"pitched\" = the suit of the first card the bid winner leads (Pitch / Setback)."
        },
        "trumpAnytime": {
          "type": "boolean",
          "description": "A player may trump even when able to follow suit (Pitch / Setback): follow suit or trump."
        },
        "breaks": {
          "enum": ["S", "H", "D", "C"],
          "description": "Suit that can't be led until one has been played."
        },
        "noPointsFirstTrick": {
          "type": "boolean"
        },
        "teams": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "bidding": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "tricks"
                },
                "nil": {
                  "type": "boolean"
                },
                "hook": {
                  "type": "boolean",
                  "description": "Dealer can't make total bids equal the tricks available."
                }
              }
            },
            {
              "type": "object",
              "required": ["type"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "euchre"
                },
                "stickTheDealer": {
                  "type": "boolean"
                },
                "alone": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "object",
              "required": ["type", "schedule"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "auction"
                },
                "schedule": {
                  "const": "avondale"
                },
                "misere": {
                  "type": "boolean",
                  "description": "Allow misère (250, over a seven) and open misère (500, any time below 10♥). Needs a `dummy` zone for the open hand."
                }
              }
            },
            {
              "type": "object",
              "required": ["type"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "bridge"
                }
              },
              "description": "Contract bridge auction: bids 1–7 in ♣ ♦ ♥ ♠ NT, pass, double, redouble. The declarer's partner is dummy."
            },
            {
              "type": "object",
              "required": ["type"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "pitch"
                }
              },
              "description": "Pitch / Setback: one round of bids of 2, 3, 4 or smudge (5); the dealer, bidding last, may take the bid by matching it, and must bid 2 if everyone passes. The winner pitches: their first lead names trumps."
            }
          ]
        },
        "scoring": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type", "cardPoints"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "penalty"
                },
                "cardPoints": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number"
                  },
                  "description": "Keys are a suit letter (every card of that suit) or a card id like \"QS\"."
                },
                "moon": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "object",
              "required": ["type"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "contract"
                },
                "nil": {
                  "type": "number"
                },
                "bags": {
                  "type": "object",
                  "required": ["every", "penalty"],
                  "properties": {
                    "every": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "penalty": {
                      "type": "number"
                    }
                  }
                },
                "overtrick": {
                  "type": "number",
                  "description": "Points for each trick over the bid (a bag). Default 1; three-handed spades: −10."
                }
              }
            },
            {
              "type": "object",
              "required": ["type", "bonus"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "exact"
                },
                "bonus": {
                  "type": "number"
                }
              }
            },
            {
              "type": "object",
              "required": ["type"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "tricks"
                }
              }
            },
            {
              "type": "object",
              "required": ["type"],
              "additionalProperties": false,
              "description": "Whist: one point a trick over six for the side taking more; honours scored with the `honours` option.",
              "properties": {
                "type": {
                  "const": "whist"
                }
              }
            },
            {
              "type": "object",
              "required": ["type"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "euchre"
                },
                "march": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Points for the makers taking all five tricks (doubled when alone). Default 2."
                },
                "euchred": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Points for the defenders when the makers fall short (doubled for a lone defender). Default 2."
                }
              }
            },
            {
              "type": "object",
              "required": ["type", "perTrick"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "auction"
                },
                "perTrick": {
                  "type": "number"
                },
                "slam": {
                  "type": "number"
                }
              }
            },
            {
              "type": "object",
              "required": ["type"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "bridge"
                }
              },
              "description": "Duplicate bridge scoring per deal, Chicago vulnerability."
            },
            {
              "type": "object",
              "required": ["type"],
              "additionalProperties": false,
              "description": "Pitch / Setback: a point each for High (the top trump in play), Low (the lowest, to whoever wins it), Jack (of trumps, to whoever wins it) and Game (most card points: A 4, K 3, Q 2, J 1, 10 10; none on a tie). The bidders score what they make if it reaches their bid, else lose the bid; smudge (all six tricks) is 5. Only bidders who make it reach the target and win.",
              "properties": {
                "type": {
                  "const": "setback"
                }
              }
            }
          ]
        },
        "end": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target": {
              "type": "number"
            },
            "lowWins": {
              "type": "boolean"
            },
            "rounds": {
              "type": "boolean"
            },
            "deals": {
              "type": "number",
              "description": "Play this many deals (option `deals` overrides)."
            },
            "loseAt": {
              "type": "number",
              "description": "A side at or below this score loses (500: -500)."
            }
          }
        },
        "bowers": {
          "type": "boolean",
          "description": "Jack of trumps and the same-colour jack are the top two trumps."
        },
        "joker": {
          "type": "boolean",
          "description": "A joker is the highest trump (500)."
        },
        "kitty": {
          "type": "integer",
          "minimum": 0,
          "description": "Cards left undealt for the bid winner (500)."
        },
        "callPartner": {
          "type": "boolean",
          "description": "500 for five: the contractor names a card, and whoever holds it is their secret partner, known when the card is played."
        },
        "duplicates": {
          "enum": ["later", "first"],
          "description": "With a double pack, two identical cards in a trick: `later` (six-handed spades) or the first played (default) wins."
        }
      }
    },
    "PokerRules": {
      "title": "PokerRules",
      "description": "Poker: Hold'em, Omaha (blinds and a board) or five card draw (antes and a draw).",
      "required": ["family", "holeCards", "board"],
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "poker"
        },
        "holeCards": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "useHole": {
          "type": "integer",
          "minimum": 0,
          "description": "0 = any five cards; N = exactly N hole cards."
        },
        "board": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Community cards dealt on each street ([] for draw poker)."
        },
        "stud": {
          "type": "boolean",
          "description": "Seven card stud: two cards down and one up, three more up, the last down; antes and a bring-in."
        },
        "draw": {
          "type": "object",
          "required": ["max"],
          "additionalProperties": false,
          "properties": {
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            }
          },
          "description": "Draw poker: everyone antes, bets, swaps up to `max` cards, then bets again."
        }
      }
    },
    "GinRules": {
      "title": "GinRules",
      "description": "Rummy games. Style \"gin\": two players draw and discard until someone knocks.",
      "required": ["family", "style", "handSize", "knockMax", "bonuses", "end"],
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "rummy"
        },
        "style": {
          "enum": ["gin"]
        },
        "handSize": {
          "type": "integer",
          "minimum": 3,
          "maximum": 13
        },
        "knockMax": {
          "type": "integer",
          "minimum": 0,
          "description": "Most deadwood you may knock with; 0 = gin only."
        },
        "bonuses": {
          "type": "object",
          "required": ["gin", "undercut"],
          "additionalProperties": false,
          "properties": {
            "gin": {
              "type": "number"
            },
            "bigGin": {
              "type": "number"
            },
            "undercut": {
              "type": "number"
            },
            "box": {
              "type": "number"
            },
            "game": {
              "type": "number"
            }
          }
        },
        "end": {
          "type": "object",
          "required": ["target"],
          "additionalProperties": false,
          "properties": {
            "target": {
              "type": "number"
            }
          }
        }
      }
    },
    "Rummy500Rules": {
      "title": "Rummy500Rules",
      "description": "Rummy 500: 2–8 players meld and lay off on the table; melded cards score, cards in hand count against you.",
      "required": ["family", "style", "end"],
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "rummy"
        },
        "style": {
          "const": "500"
        },
        "end": {
          "type": "object",
          "required": ["target"],
          "additionalProperties": false,
          "properties": {
            "target": {
              "type": "number"
            }
          }
        }
      }
    },
    "CribbageRules": {
      "title": "CribbageRules",
      "description": "Cribbage for 2–4 players (4 = partnerships).",
      "required": ["family", "target"],
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "cribbage"
        },
        "target": {
          "type": "integer",
          "minimum": 31,
          "description": "Points to win (121 standard, 61 for a short game)."
        }
      }
    },
    "ClimbingRules": {
      "title": "ClimbingRules",
      "description": "Climbing games (President): beat the last play with the same number of higher cards, or pass; first out wins.",
      "required": ["family", "style", "end"],
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "climbing"
        },
        "style": {
          "const": "president"
        },
        "end": {
          "type": "object",
          "required": ["target"],
          "additionalProperties": false,
          "properties": {
            "target": {
              "type": "number"
            }
          }
        }
      }
    },
    "CanastaRules": {
      "title": "CanastaRules",
      "description": "Classic Canasta: partnerships (or two players) meld sets with wild 2s and jokers; seven make a canasta.",
      "required": ["family", "end"],
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "canasta"
        },
        "end": {
          "type": "object",
          "required": ["target"],
          "additionalProperties": false,
          "properties": {
            "target": {
              "type": "number"
            }
          }
        }

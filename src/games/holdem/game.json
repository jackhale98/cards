{
  "$schema": "../../../schemas/game.schema.json",
  "id": "holdem",
  "name": "Texas Hold'em",
  "tagline": "No-limit poker. Two hole cards, five on the board, all the chips.",
  "aliases": ["Texas Holdem", "Poker"],
  "icon": "♠",
  "players": { "min": 2, "max": 9, "recommended": 6 },
  "bots": true,
  "deck": {},
  "zones": [
    { "id": "deck", "visibility": "none", "layout": "stack", "area": "none" },
    { "id": "muck", "visibility": "none", "layout": "stack", "area": "none" },
    { "id": "hand", "perPlayer": true, "visibility": "owner", "layout": "fan", "area": "hand" },
    { "id": "board", "label": "Board", "visibility": "all", "layout": "spread", "area": "center" }
  ],
  "chips": { "start": 1000, "smallBlind": 5, "bigBlind": 10 },
  "options": [
    { "id": "stack", "label": "Starting chips", "type": "number", "default": 1000, "min": 100, "max": 100000, "step": 100 },
    { "id": "bigBlind", "label": "Big blind", "type": "number", "default": 10, "min": 2, "max": 1000, "step": 2 }
  ],
  "rules": { "family": "poker", "holeCards": 2, "useHole": 0, "board": [3, 1, 1] },
  "rulesSummary": [
    "Each player gets two hole cards. Five shared cards come out: the flop (3), turn and river.",
    "Bet, call, raise or fold in four rounds. No limit: you can go all in at any time.",
    "Best five of the seven cards (your two and the board — you may use one, both or neither of yours) wins the pot. Ties split it."
  ]
}

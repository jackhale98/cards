{
  "$schema": "../../../schemas/game.schema.json",
  "id": "oh-hell",
  "name": "Oh Hell",
  "tagline": "Hands grow and shrink each round. Bid exactly right — no more, no less.",
  "icon": "☁",
  "players": { "min": 3, "max": 7, "recommended": 5 },
  "bots": true,
  "deck": {},
  "zones": [
    { "id": "deck", "visibility": "none", "layout": "stack", "area": "none" },
    { "id": "trump", "label": "Trump", "visibility": "all", "layout": "stack", "area": "center" },
    { "id": "hand", "perPlayer": true, "visibility": "owner", "layout": "fan", "area": "hand" },
    { "id": "trick", "label": "Trick", "visibility": "all", "layout": "trick", "area": "center" },
    { "id": "taken", "perPlayer": true, "visibility": "none", "layout": "stack", "area": "none" }
  ],
  "rules": {
    "family": "trick-taking",
    "handSizes": "ladder",
    "maxHand": 10,
    "lead": "leftOfDealer",
    "trump": "turnUp",
    "bidding": { "hook": true },
    "scoring": { "type": "exact", "bonus": 10 },
    "end": { "rounds": true }
  },
  "options": [
    { "id": "maxHand", "label": "Most cards", "type": "number", "default": 10, "min": 3, "max": 10, "step": 1 },
    { "id": "exactOnly", "label": "Only exact bids score", "type": "boolean", "default": false }
  ],
  "rulesSummary": [
    "The first deal is 10 cards each (fewer with 6 or 7 players), then one fewer each round down to one, then back up.",
    "The card turned up after the deal sets trumps. Bid exactly how many tricks you'll take.",
    "The dealer bids last and can't make the bids add up to the number of tricks.",
    "Score 1 point per trick, plus 10 for hitting your bid exactly. Highest total after the last deal wins."
  ]
}

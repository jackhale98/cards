{
  "name": "cards",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local multiplayer card table — your phone is your hand.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:quick": "vitest run --exclude tests/search.test.ts --exclude tests/bots.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "pnpm check && pnpm test && pnpm build && pnpm -C relay check",
    "verify:all": "pnpm verify && pnpm test:e2e"
  },
  "dependencies": {
    "@trystero-p2p/mqtt": "0.26.0",
    "@trystero-p2p/nostr": "0.26.0",
    "@trystero-p2p/torrent": "0.26.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/qrcode": "^1.5.6",
    "ajv": "^8.20.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
